# ===== 服务 =====
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data

# ===== 默认模型 =====
# 格式 "provider/modelId"，例如 deepseek/deepseek-chat
# 留空则由前端选择
DEFAULT_MODEL=
# 推理档位: off | minimal | low | medium | high | xhigh | max
DEFAULT_THINKING_LEVEL=off
MAX_TOKENS=
TEMPERATURE=

# ===== 模型厂商 API Key =====
# 至少配置一个。未配置的厂商不会出现在前端模型列表里。
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
KIMI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
FIREWORKS_API_KEY=
OPENCODE_API_KEY=
AI_GATEWAY_API_KEY=
