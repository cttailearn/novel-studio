# 墨耕服务端环境变量示例。
# 用法：cp .env.example .env，再按需填写；不建 .env 也能跑，全部走内置默认值。
# .env 已被 gitignore，密钥填在这里不要提交。

# ===== 运行模式 =====
# fs    —— 单机自用（默认）：数据落在 DATA_DIR 下的文件里
# idb   —— 纯浏览器模式：服务端不落盘，数据在浏览器 IndexedDB
# users —— 云端账号版：多用户注册登录，按用户目录隔离，见下面「云端账号」段
STORAGE=fs
# 单机 fs 只听本机；云端账号版对外提供服务时改成 0.0.0.0（或直接不设，
# STORAGE=users 时会自动用 0.0.0.0）
# 注意：这一行一旦写死成 127.0.0.1，STORAGE=users 的「自动 0.0.0.0」就不会再生效，
# 服务会只听本机、外面连不上。要用自动行为，就把它留空或整行删掉。
# HOST=127.0.0.1
PORT=8787
# 数据目录：cloud.db 与 users/ 都在这里，备份时整目录一起备
DATA_DIR=./data
# 站点名，显示在登录页和标题里
APP_NAME=墨耕

# ===== 云端账号（STORAGE=users 时生效）=====
# open 允许自助注册；closed 只能由管理员在后台加人
REGISTRATION=open
# 每个用户的默认配额（MB）。按 users/<用户 id>/ 目录字节数算，超了接口返回 507
DEFAULT_QUOTA_MB=1024
# 最多允许多少个账号，0 表示不限
MAX_USERS=0
# 登录态有效期（天）
SESSION_DAYS=30
# 口令最短长度（代码里下限是 6）
PASSWORD_MIN_LENGTH=8
# 没有用户时，用下面的邮箱口令自动建第一个管理员
FIRST_USER_ADMIN=1
# 首管理员账号，务必改掉；留空则不自动创建，第一个注册的人就是管理员
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 部署在 HTTPS 反代后面保持 auto（按请求协议判断）；纯 http 内网调试可设 never
COOKIE_SECURE=auto
# 在 nginx / Caddy 等反代后面设 1，才会信任 X-Forwarded-For 与 X-Forwarded-Proto
TRUST_PROXY=0

# ===== 浏览器直连厂商（中继）=====
# 中继允许转发的目标主机，逗号分隔。留空 = 允许任意公开 https 主机
# （私网/回环地址始终拦截），等于把服务器变成任何人都能借用的跳板，
# 云端版务必列成厂商域名白名单，例如：
#   RELAY_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,api.anthropic.com
RELAY_ALLOWED_HOSTS=
# 额外允许跨源访问的来源，逗号分隔（中继取第一个，账号接口全部认）。
# 留空即可：Tauri/手机外壳的 tauri://localhost、http(s)://tauri.localhost
# 与 tauri dev 的 :1420 已默认放行，不需要写在这里。
CORS_ORIGINS=
# 中继的流量限制（每分钟每个 IP 的请求数、同时在途的请求数）。
# 分桶用的 IP 只有在 TRUST_PROXY=1 时才采信 X-Forwarded-For，否则一律用真实对端地址。
RELAY_REQUESTS_PER_MINUTE=60
RELAY_MAX_INFLIGHT=16
# 中继单次请求/响应的体积上限（字节）与超时（毫秒）
RELAY_MAX_REQUEST_BYTES=8388608
RELAY_MAX_RESPONSE_BYTES=67108864
RELAY_TIMEOUT_MS=180000

# ===== 其它 =====
# .env 文件位置，默认是进程工作目录下的 .env；改成别的路径可放多份配置
# NOVEL_STUDIO_ENV_FILE=./.env

# ===== 默认模型 =====
# 格式 "provider/modelId"，例如 deepseek/deepseek-chat；留空由前端选择
DEFAULT_MODEL=
# 推理档位: off | minimal | low | medium | high | xhigh | max
DEFAULT_THINKING_LEVEL=off
# 下面两项是历史配置，服务端当前不读取（生成参数在界面里按模型设置）
MAX_TOKENS=
TEMPERATURE=

# ===== 模型厂商 API Key =====
# 至少配置一个，未配置的厂商不会出现在前端模型列表里。
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
KIMI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
FIREWORKS_API_KEY=
OPENCODE_API_KEY=
AI_GATEWAY_API_KEY=
