{
  "name": "novel-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server/main.ts",
    "start": "node --experimental-strip-types src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test:tools": "node --experimental-strip-types scripts/smoke.ts",
    "test:loop": "node --experimental-strip-types scripts/agent-loop.ts",
    "test": "pnpm typecheck && pnpm test:tools && pnpm test:loop"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
