{
  "name": "novel-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cttailearn/novel-studio.git"
  },
  "homepage": "https://github.com/cttailearn/novel-studio#readme",
  "bugs": {
    "url": "https://github.com/cttailearn/novel-studio/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server/main.ts",
    "start": "node --experimental-strip-types src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test:tools": "node --experimental-strip-types scripts/smoke.ts",
    "test:loop": "node --experimental-strip-types scripts/agent-loop.ts",
    "test:config": "node --experimental-strip-types scripts/config.ts",
    "test:server": "node --experimental-strip-types scripts/workbench.ts",
    "test:storage": "node --experimental-strip-types scripts/storage-check.ts",
    "test:frontend": "node --experimental-vm-modules scripts/frontend-contracts.mjs",
    "test:context": "node --experimental-strip-types scripts/ai-context-check.ts",
    "test:idb": "node --experimental-strip-types scripts/idb-storage-check.ts && node --experimental-strip-types scripts/idb-stores-check.ts",
    "test:package": "node --experimental-strip-types scripts/novel-package-check.ts",
    "test:local": "node --experimental-strip-types scripts/local-api-check.ts",
    "test:relay": "node --experimental-strip-types scripts/relay-check.ts",
    "build:browser": "node --experimental-strip-types scripts/browser-build.ts",
    "test:browser": "node --experimental-strip-types scripts/browser-build-check.ts",
    "test": "pnpm typecheck && pnpm test:config && pnpm test:tools && pnpm test:context && pnpm test:storage && pnpm test:server && pnpm test:loop && pnpm test:frontend && pnpm test:idb && pnpm test:package && pnpm test:local && pnpm test:relay"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
