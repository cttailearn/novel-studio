{
  "name": "@local/dsh-novel-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Novel writing workbench for DeepSeek Harness: projects, chapters, materials and continuity notes as a first-class DSH main panel.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./role/material": "./lib/role-material.js",
    "./role/writing": "./lib/role-writing.js",
    "./role/adapt": "./lib/role-adapt.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
